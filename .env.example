# Copy to .env.local for `npm run dev`. Nothing here is a secret.

# reCAPTCHA Enterprise site key registered for App Check (public by design).
VITE_RECAPTCHA_SITE_KEY=

# Local dev only: the Firebase web app config as one line of JSON (Firebase
# console > Project settings > Your apps). Deployed builds read it from
# /__/firebase/init.json on Firebase Hosting instead.
VITE_FIREBASE_CONFIG=

# Optional: a registered App Check debug token for local dev.
VITE_APPCHECK_DEBUG_TOKEN=
